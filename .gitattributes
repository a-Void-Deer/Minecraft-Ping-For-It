* text=auto eol=crlf

*.java text eol=lf
*.gradle text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Unix launchers and scripts must keep LF even on Windows checkouts, otherwise
# the shebang becomes "#!/bin/sh\r" and Linux runners fail with exit 127.
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# binaries
*.jar binary
*.png binary
*.ogg binary
